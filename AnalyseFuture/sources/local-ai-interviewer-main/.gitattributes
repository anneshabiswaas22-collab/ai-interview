* text=auto
# Source and docs are LF everywhere (matches .editorconfig), so Windows checkouts produce no line-ending diffs.
*.py   text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
# Windows scripts need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.png  binary
*.woff2 binary
