# Editor defaults matching the existing code. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{py,ts,tsx,js,mjs,css,html,json,yml,yaml,md}]
indent_style = space

[*.py]
indent_size = 4

[*.{ts,tsx,js,mjs,css,html,json,yml,yaml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
